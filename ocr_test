from pdf2image import convert_from_path
import pytesseract
import sqlite3
import os

# Folder containing your SDS PDFs
folder_path = "/Users/nate/Documents/SDS Data Sheets"

# Connect to database
conn = sqlite3.connect("sds.db")
cursor = conn.cursor()

# Create table
cursor.execute("""
CREATE TABLE IF NOT EXISTS sds (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    file_name TEXT,
    file_path TEXT,
    content TEXT
)
""")

# Loop through all files in folder
for file in os.listdir(folder_path):
    if file.endswith(".pdf"):
        pdf_path = os.path.join(folder_path, file)
        
        print(f"Processing: {file}")
        
        try:
            pages = convert_from_path(pdf_path, 300)
            full_text = ""

            for page in pages:
                text = pytesseract.image_to_string(page)
                full_text += text + "\n"

            # Save to database
            cursor.execute(
                "SELECT id FROM sds WHERE file_name = ?",
                (file,)
            )

            if cursor.fetchone() is None:
                cursor.execute(
                    "INSERT INTO sds (file_name, file_path, content) VALUES (?,?,?)",
                    (file, pdf_path, full_text)
                )
                print(f"Saved: {file}")
            else:
                print(f"Skipped (already exists): {file}")

        except Exception as e:
            print(f"Error processing {file}: {e}")

# Save changes
conn.commit()
conn.close()

print("All PDFs processed!")
