<script>(function(){const versionResourcePath = "";
const pageHostRedirectPath = "";
const devEnvironment = "false";

  var versionResourceReq = null;
  if ((versionResourcePath.trim().length > 0) && (pageHostRedirectPath.trim().length > 0)) {
    versionResourceReq = new XMLHttpRequest();
  }
  if (versionResourceReq) {
    versionResourceReq.addEventListener('load', function() {
      var version = versionResourceReq.responseText || '';
      var queryStr = location.search || '';
      if (('' + devEnvironment).toLocaleLowerCase() === 'true') {
        console.log(`>>>>>>>>>> VersionCheckRedirect Development Mode <<<<<<<<<<`);
        console.log(`versionResourcePath: (${versionResourcePath})`);
        console.log(`pageHostRedirectPath: (${pageHostRedirectPath})`);
        console.log(`page query string: (${queryStr})`);
        console.log(`version: (${version})`);
        if ((version.trim().length > 0) && (queryStr.indexOf('?' + version) === -1) && (queryStr.indexOf('&' + version) === -1)) {
          console.log(`Version not valid in query string, so redirect would use location.replace with pageHostRedirectPath!`);
        }
      } else if ((version.trim().length > 0) && (queryStr.indexOf('?' + version) === -1) && (queryStr.indexOf('&' + version) === -1)) {
        location.replace(pageHostRedirectPath);
      }
    });
    versionResourceReq.open('GET', versionResourcePath, true);
    versionResourceReq.send();
  }
})();</script>
<script type="module">/**
 * String.prototype.replaceAll() polyfill
 * https://gomakethings.com/how-to-replace-a-section-of-a-string-with-another-one-with-vanilla-js/
 * @author Chris Ferdinandi
 * @license MIT
 */
if (!String.prototype.replaceAll) {
  String.prototype.replaceAll = function(searchValue, replacer) {
    if (Object.prototype.toString.call(searchValue).toLowerCase() === "[object regexp]") {
      return this.replace(searchValue, replacer);
    }
    return this.replace(new RegExp(searchValue, "g"), replacer);
  };
}</script>
<script>
window['hearsFunctionCaller'] = function(functionName, attemptsCnt, ...args) {
	if (!functionName || (attemptsCnt && (attemptsCnt >= 8))) return
	if (typeof(window[functionName]) === 'function') {
		window[functionName](...args)
	} else {
		const nextCnt = (attemptsCnt || 0) + 1
		setTimeout(function() {
			window['hearsFunctionCaller'](functionName, nextCnt, ...args)
		}, 250)
	}
}
</script>

